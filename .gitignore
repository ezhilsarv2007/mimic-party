# ==========================================
# MIMIC PARTY — .gitignore
# ==========================================

# Dependencies
node_modules/

# Build output
dist/
build/
.vite/

# Python
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/

# Environment variables (NEVER commit secrets)
.env
.env.local
.env.*.local
.env.development
.env.production

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# TypeScript incremental
*.tsbuildinfo

# Temporary
*.tmp
*.temp

# Coverage
coverage/
.nyc_output/
