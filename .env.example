# ==========================================
# MIMIC PARTY — Environment Variables
# ==========================================
# Copy this file to .env and fill in values.
# NEVER commit the .env file with real secrets.
# ==========================================

# --- Server (Node.js Game Server) ---
PORT=3001
CLIENT_URL=

# --- Audio Analysis Service URL (Python FastAPI) ---
AUDIO_SERVICE_URL=

# --- Gemini API Key (optional — enables dynamic AI Judge commentary) ---
# Get one free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Frontend (Vite — prefix with VITE_) ---
# Set this to your deployed game server URL for production.
# In local development this defaults to http://localhost:3001
VITE_SERVER_URL=
